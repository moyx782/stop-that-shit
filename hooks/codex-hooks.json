{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/stop-that-shit/hooks/stop-that-shit.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/stop-that-shit/hooks/stop-that-shit.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(spawn_agent|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/stop-that-shit/hooks/stop-that-shit.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
